#!/usr/bin/env bash
# Installs HAProxy on lb-01 and balances traffic to web-01 and web-02 (roundrobin)
apt-get -y update
apt-get -y install haproxy
echo "ENABLED=1" >> /etc/default/haproxy
cat > /etc/haproxy/haproxy.cfg <<'CONF'
global
    log /dev/log local0
    maxconn 2048
    user haproxy
    group haproxy
    daemon

defaults
    log global
    mode http
    option httplog
    option dontlognull
    timeout connect 5000
    timeout client 50000
    timeout server 50000

frontend http_front
    bind *:80
    default_backend http_back

backend http_back
    balance roundrobin
    server 7247-web-01 13.135.173.98:80 check
    server 7247-web-02 18.130.149.31:80 check
CONF
service haproxy restart
